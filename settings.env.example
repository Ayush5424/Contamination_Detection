# Copy this file to settings.env and fill in what you need. Every line is optional.

# ---- database (default: SQLite file data/monitor.db, nothing to install)
# DATABASE_URL=mysql+pymysql://wq:wq_password@localhost:3306/water_quality

# ---- optional InfluxDB time-series mirror
# INFLUX_URL=http://localhost:8086
# INFLUX_TOKEN=my-token
# INFLUX_ORG=jims
# INFLUX_BUCKET=cooling_water

# ---- MQTT broker
# MQTT_HOST=localhost
# MQTT_PORT=1883
# DEVICE_ID=loop1

# ---- forecaster used by the ingestion service: lstm or xgb
# FORECASTER=lstm

# ---- built-in live system of the API (MQTT broker if needed + sensor feeder agent + ingestion worker)
# 0 when broker.py / ingest_service.py / sensor_publisher.py run as separate processes
# LIVE_AGENT=1
# real seconds between two readings (each = 5 plant minutes); 300 = true real time
# FEEDER_INTERVAL=1

# ---- notifications
# desktop pop-up on this computer (1 = on, 0 = off)
# DESKTOP_NOTIFY=1

# e-mail (Gmail: turn on 2-step verification and create an "App password")
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password
# ALERT_EMAIL_TO=operator@example.com

# phone push: install the free "ntfy" app, subscribe to a topic name only you know, and put it here
# NTFY_TOPIC=jims-cooling-water-demo-7391

# any webhook that accepts JSON (Slack / Discord / Teams incoming webhook, n8n, ...)
# WEBHOOK_URL=
